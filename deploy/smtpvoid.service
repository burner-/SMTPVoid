# systemd unit for SMTPVoid.
# Install the binary to /usr/local/bin/smtpvoid, then:
#   sudo useradd --system --home /var/lib/smtpvoid --create-home smtpvoid
#   sudo cp deploy/smtpvoid.service /etc/systemd/system/
#   sudo systemctl enable --now smtpvoid
[Unit]
Description=SMTPVoid - SMTP black hole for testing mail submission
After=network-online.target
Wants=network-online.target

[Service]
User=smtpvoid
Group=smtpvoid
ExecStart=/usr/local/bin/smtpvoid
# These two are the only environment settings; everything else (hostname,
# listener addresses, retention, Let's Encrypt) is configured at /admin/settings.
Environment=SMTPVOID_DATA_DIR=/var/lib/smtpvoid
Environment=SMTPVOID_HTTP_ADDR=0.0.0.0:8080

# Needed to bind the privileged ports the admin UI can be pointed at:
# 25/587 (SMTP), 465 (SMTPS), 80 (ACME HTTP-01 challenge), 443 (HTTPS UI).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smtpvoid
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
